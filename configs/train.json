{
    "train_list": "./datasets/XACLE_Challenge_2027_development_dataset/meta_data/train_average.csv",
    "validation_list": "./datasets/XACLE_Challenge_2027_development_dataset/meta_data/validation_average.csv",
    "test_list": "./datasets/XACLE_Challenge_2027_development_dataset/meta_data/test_average.csv",
    "wav_dir": "./datasets/XACLE_Challenge_2027_development_dataset/wav",
    "output_dir": "./chkpt",
    "batch_size": 12,
    "val_batch_size": 12,
    "lr": 0.00002,
    "num_workers": 8,
    "epochs": 20,
    "max_len": 10,
    "early_stop_patience": 10,
    "device": "cuda",
    "seed": 42,
    "loss": {
        "loss_weights": [1.0, 0.5],
        "clipped_mse": {
            "tau": 0.25,
            "mode": "utt",
            "beta": 0.99,
            "cbl": true
        },
        "contrastive": {
            "margin": 0.1,
            "beta": 0.99,
            "cbl": true
        }
    },
    "m2d_clap": {
        "checkpoint": "./models/m2d/checkpoints/m2d_clap_vit_base-80x1001p16x16p16kpBpTI-2025/checkpoint-30.pth",
        "cache_dir": "./hf_cache",
        "sample_rate": 16000,
        "embedding_dim": 768,
        "freeze": true,
        "normalize_embeddings": true
    },
    "model": {
        "projector": {
            "hidden_dim": 1024,
            "output_dim": 256,
            "activation": "ReLU",
            "dropout": 0.3
        },
        "score_predictor": {
            "range_clipping": false
        }
    }
}
