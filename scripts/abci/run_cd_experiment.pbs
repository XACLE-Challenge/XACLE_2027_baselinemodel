#!/bin/bash
#PBS -N xacle27_cd
#PBS -P gch51642
#PBS -q rt_HG
#PBS -l select=1
#PBS -l walltime=00:15:00
#PBS -j oe
#PBS -m n

set -euo pipefail
cd "${PBS_O_WORKDIR}"

source /etc/profile.d/modules.sh
module purge
module load python/3.12/3.12.9 cuda/13.0/13.0.1
source .venv-abci/bin/activate

export HF_HOME="${PBS_O_WORKDIR}/hf_cache"
export TOKENIZERS_PARALLELISM=false

EXPERIMENT_DIR="chkpt_cd"

python scripts/experiments/validate_cd_metadata.py
nvidia-smi

for VARIANT in C D; do
  CONFIG="configs/experiments/train_${VARIANT}.json"
  python train.py --config "${CONFIG}"
done

for MODEL_VARIANT in C D; do
  OUTPUT_ROOT="${EXPERIMENT_DIR}/${MODEL_VARIANT}"
  RUN_DIR="$(find "${OUTPUT_ROOT}" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' | sort -nr | head -1 | cut -d' ' -f2-)"
  test -n "${RUN_DIR}"
  test -f "${RUN_DIR}/best_model.pt"

  for DATA_VARIANT in C D; do
    for SPLIT in validation test; do
      METADATA="datasets/XACLE_dataset/meta_data/experiments/${SPLIT}_${DATA_VARIANT}.csv"
      RESULT_NAME="${SPLIT}_${DATA_VARIANT}"
      EVAL_DIR="${EXPERIMENT_DIR}/evaluation/model_${MODEL_VARIANT}/data_${DATA_VARIANT}/${SPLIT}"
      mkdir -p "${EVAL_DIR}"

      python inference.py "${RUN_DIR}" "${SPLIT}" \
        --metadata-list "${METADATA}" \
        --result-name "${RESULT_NAME}"
      python evaluate.py \
        "${RUN_DIR}/inference_result_for_${RESULT_NAME}.csv" \
        "${METADATA}" \
        "${EVAL_DIR}"
    done
  done
done

python scripts/experiments/summarize_cd_results.py "${EXPERIMENT_DIR}"
