#!/bin/bash
#PBS -N xacle27_train
#PBS -P gag51394
#PBS -q rt_HG
#PBS -l select=1
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -m n

set -euo pipefail
cd "${PBS_O_WORKDIR}"

source /etc/profile.d/modules.sh
module purge
module load python/3.12/3.12.9 cuda/13.0/13.0.1
source .venv-abci/bin/activate

export HF_HOME="${PBS_O_WORKDIR}/hf_cache"
export TOKENIZERS_PARALLELISM=false

nvidia-smi
python train.py --config configs/train.json
